{
  "name": "desktop-app-for-inventory-and-employee-management",
  "version": "1.0.0",
  "description": "Swaraj Enterprises ERP - Desktop Application for Inventory and Employee Management",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:3000 && cross-env NODE_ENV=development electron .",
    "build": "npm run build:vite && npm run build:electron",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.node.json && electron-builder",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --publish=never"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PulKiTgUpTACoDe/desktop-app-for-inventory-and-employee-management.git"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "erp",
    "inventory",
    "management"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/PulKiTgUpTACoDe/desktop-app-for-inventory-and-employee-management/issues"
  },
  "homepage": "https://github.com/PulKiTgUpTACoDe/desktop-app-for-inventory-and-employee-management#readme",
  "build": {
    "appId": "com.swaraj.erp",
    "productName": "Swaraj Enterprises ERP",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "postcss": "^8.4.0",
    "prisma": "^5.0.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "lucide-react": "^0.300.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tailwind-merge": "^2.0.0"
  }
}
