{
  "name": "desktop-app-for-inventory-and-employee-management",
  "version": "1.0.0",
  "description": "Swaraj Enterprises ERP - Desktop Application for Inventory and Employee Management",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:3000 && cross-env NODE_ENV=development electron .",
    "build": "npm run build:vite && npm run build:electron",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.node.json && electron-builder",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --publish=never",
    "seed": "tsx src/lib/seed-data.ts",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --target=node18 --format=cjs --external:electron --outfile=dist-electron/electron/preload.js --sourcemap"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PulKiTgUpTACoDe/desktop-app-for-inventory-and-employee-management.git"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "erp",
    "inventory",
    "management"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/PulKiTgUpTACoDe/desktop-app-for-inventory-and-employee-management/issues"
  },
  "homepage": "https://github.com/PulKiTgUpTACoDe/desktop-app-for-inventory-and-employee-management#readme",
  "build": {
    "appId": "com.swaraj.erp",
    "productName": "Swaraj Enterprises ERP",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@prisma/client": "^6.15.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "esbuild": "^0.25.10",
    "postcss": "^8.4.0",
    "prisma": "^6.15.0",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@prisma/extension-accelerate": "^2.0.2",
    "axios": "^1.11.0",
    "better-sqlite3": "^12.4.1",
    "body-parser": "^2.2.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "lucide-react": "^0.300.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-hook-form": "^7.62.0",
    "react-router-dom": "^7.8.2",
    "tailwind-merge": "^2.0.0",
    "zod": "^4.1.5"
  }
}
