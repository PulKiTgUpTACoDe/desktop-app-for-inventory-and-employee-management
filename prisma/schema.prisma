generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id                      String            @id @default(cuid())
  username                String            @unique
  password                String
  email                   String            @unique
  fullName                String
  role                    String            @default("admin")
  isActive                Boolean           @default(true)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  updatedEmployees        Employee[]        @relation("EmployeeUpdatedBy")
  createdEmployees        Employee[]        @relation("EmployeeCreatedBy")
  processedPayrolls       Payroll[]         @relation("PayrollProcessedBy")
  createdPayrolls         Payroll[]         @relation("PayrollCreatedBy")
  updatedBrands           ProductBrand[]    @relation("BrandUpdatedBy")
  createdBrands           ProductBrand[]    @relation("BrandCreatedBy")
  updatedCategories       ProductCategory[] @relation("CategoryUpdatedBy")
  createdCategories       ProductCategory[] @relation("CategoryCreatedBy")
  updatedProducts         Product[]         @relation("ProductUpdatedBy")
  createdProducts         Product[]         @relation("ProductCreatedBy")
  processedPurchaseOrders PurchaseOrder[]   @relation("PurchaseOrderProcessedBy")
  createdPurchaseOrders   PurchaseOrder[]   @relation("PurchaseOrderCreatedBy")
  processedSalesOrders    SalesOrder[]      @relation("SalesOrderProcessedBy")
  createdSalesOrders      SalesOrder[]      @relation("SalesOrderCreatedBy")
  updatedSuppliers        Supplier[]        @relation("SupplierUpdatedBy")
  createdSuppliers        Supplier[]        @relation("SupplierCreatedBy")
  updatedVendors          Vendor[]          @relation("VendorUpdatedBy")
  createdVendors          Vendor[]          @relation("VendorCreatedBy")

  @@map("admin_users")
}

model ProductCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String
  updatedBy   String
  updater     AdminUser @relation("CategoryUpdatedBy", fields: [updatedBy], references: [id])
  creator     AdminUser @relation("CategoryCreatedBy", fields: [createdBy], references: [id])
  products    Product[]

  @@map("product_categories")
}

model ProductBrand {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String
  updatedBy   String
  updater     AdminUser @relation("BrandUpdatedBy", fields: [updatedBy], references: [id])
  creator     AdminUser @relation("BrandCreatedBy", fields: [createdBy], references: [id])
  products    Product[]

  @@map("product_brands")
}

model Product {
  id                 String              @id @default(cuid())
  name               String
  sku                String              @unique
  description        String?
  price              Decimal
  costPrice          Decimal
  categoryId         String
  brandId            String
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdBy          String
  updatedBy          String
  updater            AdminUser           @relation("ProductUpdatedBy", fields: [updatedBy], references: [id])
  creator            AdminUser           @relation("ProductCreatedBy", fields: [createdBy], references: [id])
  brand              ProductBrand        @relation(fields: [brandId], references: [id])
  category           ProductCategory     @relation(fields: [categoryId], references: [id])
  purchaseOrderItems PurchaseOrderItem[]
  salesOrderItems    SalesOrderItem[]
  stock              Stock[]

  @@map("products")
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  email          String?
  phone          String?
  address        String?
  contactPerson  String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdBy      String
  updatedBy      String
  purchaseOrders PurchaseOrder[]
  updater        AdminUser       @relation("SupplierUpdatedBy", fields: [updatedBy], references: [id])
  creator        AdminUser       @relation("SupplierCreatedBy", fields: [createdBy], references: [id])

  @@map("suppliers")
}

model Vendor {
  id            String       @id @default(cuid())
  name          String
  email         String?
  phone         String?
  address       String?
  contactPerson String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  createdBy     String
  updatedBy     String
  salesOrders   SalesOrder[]
  updater       AdminUser    @relation("VendorUpdatedBy", fields: [updatedBy], references: [id])
  creator       AdminUser    @relation("VendorCreatedBy", fields: [createdBy], references: [id])

  @@map("vendors")
}

model Stock {
  id        String   @id @default(cuid())
  productId String
  quantity  Int
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id])

  @@map("stock")
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  orderNumber      String              @unique
  supplierId       String
  orderDate        DateTime
  expectedDelivery DateTime?
  status           String              @default("pending")
  totalAmount      Decimal
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  createdBy        String
  processedBy      String?
  items            PurchaseOrderItem[]
  processor        AdminUser?          @relation("PurchaseOrderProcessedBy", fields: [processedBy], references: [id])
  creator          AdminUser           @relation("PurchaseOrderCreatedBy", fields: [createdBy], references: [id])
  supplier         Supplier            @relation(fields: [supplierId], references: [id])

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitPrice       Decimal
  totalPrice      Decimal
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  product         Product       @relation(fields: [productId], references: [id])
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

model SalesOrder {
  id               String           @id @default(cuid())
  orderNumber      String           @unique
  vendorId         String
  orderDate        DateTime
  expectedDelivery DateTime?
  status           String           @default("pending")
  totalAmount      Decimal
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  createdBy        String
  processedBy      String?
  invoice          Invoice?
  items            SalesOrderItem[]
  processor        AdminUser?       @relation("SalesOrderProcessedBy", fields: [processedBy], references: [id])
  creator          AdminUser        @relation("SalesOrderCreatedBy", fields: [createdBy], references: [id])
  vendor           Vendor           @relation(fields: [vendorId], references: [id])

  @@map("sales_orders")
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  salesOrderId String
  productId    String
  quantity     Int
  unitPrice    Decimal
  totalPrice   Decimal
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  product      Product    @relation(fields: [productId], references: [id])
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@map("sales_order_items")
}

model Invoice {
  id            String     @id @default(cuid())
  invoiceNumber String     @unique
  salesOrderId  String     @unique
  invoiceDate   DateTime
  dueDate       DateTime
  totalAmount   Decimal
  status        String     @default("pending")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  salesOrder    SalesOrder @relation(fields: [salesOrderId], references: [id])
  payments      Payment[]

  @@map("invoices")
}

model Payment {
  id            String   @id @default(cuid())
  invoiceId     String
  amount        Decimal
  paymentDate   DateTime
  paymentMethod String
  reference     String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  invoice       Invoice  @relation(fields: [invoiceId], references: [id])

  @@map("payments")
}

model Employee {
  id         String    @id @default(cuid())
  employeeId String    @unique @default(cuid())
  firstName  String
  lastName   String
  email      String    @unique
  phone      String?
  address    String?
  position   String
  department String
  hireDate   DateTime
  salary     Decimal
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createdBy  String
  updatedBy  String
  updater    AdminUser @relation("EmployeeUpdatedBy", fields: [updatedBy], references: [id])
  creator    AdminUser @relation("EmployeeCreatedBy", fields: [createdBy], references: [id])
  payrolls   Payroll[]

  @@map("employees")
}

model Payroll {
  id          String     @id @default(cuid())
  employeeId  String
  month       Int
  year        Int
  basicSalary Decimal
  allowances  Decimal
  deductions  Decimal
  netSalary   Decimal
  status      String     @default("pending")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   String
  processedBy String?
  processor   AdminUser? @relation("PayrollProcessedBy", fields: [processedBy], references: [id])
  creator     AdminUser  @relation("PayrollCreatedBy", fields: [createdBy], references: [id])
  employee    Employee   @relation(fields: [employeeId], references: [id])
  payslip     Payslip?

  @@unique([employeeId, month, year])
  @@map("payrolls")
}

model Payslip {
  id            String   @id @default(cuid())
  payrollId     String   @unique
  payslipNumber String   @unique
  issueDate     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  payroll       Payroll  @relation(fields: [payrollId], references: [id])

  @@map("payslips")
}
