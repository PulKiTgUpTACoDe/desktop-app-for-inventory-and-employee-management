{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "target": "ES2020",
    "lib": ["ES2020"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist-electron",
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "electron",
    "src/lib/prisma.ts",
    "src/types/employee.ts"
  ],
  "exclude": [
    "src/services/**/*"
  ]
}
